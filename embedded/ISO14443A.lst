  61          //output:status=MI_OK:成功
  62          //       得到的序列号放入指定单元
  63          /////////////////////////////////////////////////////////////////////
  64          char PcdAnticoll(unsigned char *pSnr)
  65          {
  66   1          char  idata status ;
  67   1          unsigned char i;
  68   1          unsigned char ucBits;
  69   1          unsigned char ucBytes;
  70   1          unsigned char snr_check = 0;
  71   1          unsigned char ucCollPosition = 0;
  72   1          unsigned char ucTemp;
  73   1          unsigned char idata ucSNR[5] = {0, 0, 0, 0 ,0};
  74   1          struct TranSciveBuffer MfComData;
  75   1          struct TranSciveBuffer *pi;
  76   1          pi = &MfComData;
  77   1      
  78   1          WriteRawRC(RegDecoderControl,0x28);
  79   1          ClearBitMask(RegControl,0x08);
  80   1          WriteRawRC(RegChannelRedundancy,0x03);
  81   1          PcdSetTmo(4);
  82   1          
  83   1      
  84   1          do
  85   1          {
  86   2              ucBits = (ucCollPosition) % 8;
  87   2              if (ucBits != 0)
  88   2              {
  89   3                   ucBytes = ucCollPosition / 8 + 1;
  90   3                   WriteRawRC(RegBitFraming, (ucBits << 4) + ucBits);
  91   3              }
  92   2              else
  93   2              {
  94   3                   ucBytes = ucCollPosition / 8;
  95   3              }
  96   2              
  97   2              MfComData.MfCommand = PCD_TRANSCEIVE;
  98   2              MfComData.MfData[0] = PICC_ANTICOLL1;
  99   2              MfComData.MfData[1] = 0x20 + ((ucCollPosition / 8) << 4) + (ucBits & 0x0F);
 100   2              for (i=0; i<ucBytes; i++)
 101   2                  {
 102   3                      MfComData.MfData[i + 2] = ucSNR[i];
 103   3                  }
 104   2                  MfComData.MfLength = ucBytes + 2;
 105   2              
 106   2                  status = PcdComTransceive(pi);
 107   2              
 108   2                  ucTemp = ucSNR[(ucCollPosition / 8)];
 109   2                  if (status == MI_COLLERR)
 110   2                  {
 111   3                      for (i=0; i < 5 - (ucCollPosition / 8); i++)
 112   3                      {
 113   4                               ucSNR[i + (ucCollPosition / 8)] = MfComData.MfData[i+1];
 114   4                      }
 115   3                      ucSNR[(ucCollPosition / 8)] |= ucTemp;
 116   3                      ucCollPosition = MfComData.MfData[0];
C51 COMPILER V9.00   ISO14443A                                                             06/07/2017 15:27:12 PAGE 3   

 117   3              }
 118   2              else if (status == MI_OK)
 119   2              {
 120   3                  for (i=0; i < (MfComData.MfLength / 8); i++)
 121   3                  {
 122   4                       ucSNR[4 - i] = MfComData.MfData[MfComData.MfLength/8 - i - 1];
 123   4                  }
 124   3                  ucSNR[(ucCollPosition / 8)] |= ucTemp;
 125   3              }
 126   2          } while (status == MI_COLLERR);
 127   1                              
 128   1                              
 129   1          if (status == MI_OK)
 130   1          {
 131   2               for (i=0; i<4; i++)
 132   2               {   
 133   3                   *(pSnr+i)  = ucSNR[i];
 134   3                   snr_check ^= ucSNR[i];
 135   3               }
 136   2               if (snr_check != ucSNR[i])
 137   2               {   status = MI_COM_ERR;    }
 138   2          }
 139   1          
 140   1          ClearBitMask(RegDecoderControl,0x20);
 141   1          return status;
 142   1      }
