  49   2              if (MfComData.MfLength != 0x10)
  50   2              {   status = MI_BITCOUNTERR;   }
  51   2         }
  52   1         *pTagType     = MfComData.MfData[0];
  53   1         *(pTagType+1) = MfComData.MfData[1];
  54   1         
