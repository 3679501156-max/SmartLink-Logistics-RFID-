 792          /////////////////////////////////////////////////////////////////////
 793          //向ISO14443-4卡发送COS命令
 794          //input:CID_NAD  = 是否包含CID或NAD             CID卡片标识符 NAD节点
 795          //      timeout  = FWI                                  桢等待时间的整数
 796          //      pLen     = 命令长度
 797          //      pCommand = COS命令
 798          //ouput:pLen     = 返回数据长度
C51 COMPILER V9.00   ISO14443A                                                             06/07/2017 15:27:12 PAGE 14  

 799          //      pCommand = 返回数据
 800          /////////////////////////////////////////////////////////////////////
 801          char MifareProCom(unsigned char CID_NAD,unsigned char timeout,unsigned char *pLen,unsigned char *pCommand)
 802          {
 803   1          char status;
 804   1          struct TranSciveBuffer MfComData;
 805   1          struct TranSciveBuffer *pi;
 806   1          unsigned char i,CidNadLg,PCB_I,PCB_R;
 807   1          unsigned char idata sendlgok,sendlgnow,sendlgsum,recelgnow,recelgsum;
 808   1          
 809   1          recelgnow = 0x00;
 810   1          recelgsum = 0x00;
 811   1          sendlgnow = 0x00;
 812   1          sendlgok  = 0x00;
 813   1          sendlgsum = *pLen;
 814   1          PCB_R     = 0xA2;
 815   1          
 816   1          PcdSetTmo(timeout);
 817   1          
 818   1      
 819   1          if (CID_NAD & 0xF0)
 820   1          {   CidNadLg = 1;    }
 821   1          else
 822   1          {   CidNadLg = 0;    }    
 823   1          if (sendlgsum > FSD-1-CidNadLg)
 824   1          {
 825   2              sendlgnow  = FSD-1-CidNadLg;
 826   2              sendlgsum -= sendlgnow;
 827   2              PCB_I = 0x12 ^ g_bIblock;
 828   2          }    
 829   1          else
 830   1          {   
 831   2              sendlgnow  = sendlgsum;
 832   2              PCB_I = 0x02 ^ g_bIblock;
 833   2          }
 834   1          g_bIblock = !g_bIblock;    
 835   1          MfComData.MfCommand = PCD_TRANSCEIVE;
 836   1          MfComData.MfLength  = sendlgnow + CidNadLg + 1;
 837   1          MfComData.MfData[0] =( CidNadLg<<3) | PCB_I;
 838   1          for (i=0; i<CidNadLg; i++)
 839   1          {  MfComData.MfData[i+1] = 1;  } 
 840   1          memcpy(&MfComData.MfData[CidNadLg+1], pCommand, sendlgnow);   
 841   1          sendlgok += sendlgnow;
 842   1          pi = &MfComData;
 843   1          
 844   1          status = PcdComTransceive(pi);
 845   1         
 846   1      //////////////////////////////////////////////
 847   1          while (status == MI_OK)
 848   1          {
 849   2              if (MfComData.MfLength/8-1-CidNadLg > FSD)
 850   2              {   
 851   3                  status = MI_COM_ERR;
 852   3                  break;
 853   3              }
 854   2              if ((MfComData.MfData[0] & 0xF0) == 0x00) 
 855   2              //命令通讯结束
 856   2              {
 857   3                  recelgnow = MfComData.MfLength/8 - 1 - CidNadLg;
 858   3                  memcpy(pCommand+recelgsum, &MfComData.MfData[CidNadLg+1], recelgnow);    
 859   3                  recelgsum += recelgnow;
 860   3                  *pLen = recelgsum;
C51 COMPILER V9.00   ISO14443A                                                             06/07/2017 15:27:12 PAGE 15  

 861   3                  break;
 862   3              }  
 863   2      
 864   2      
 865   2                 if ((MfComData.MfData[0] & 0xF0) == 0xF0)
 866   2              //执行擦除目录操作后，启动WTX机制后，卡片返回以F开头的数据。
 867   2              {
 868   3                    MfComData.MfCommand = PCD_TRANSCEIVE;
 869   3                                 recelgnow = MfComData.MfLength/8 - 1 - CidNadLg;
 870   3                  MfComData.MfLength  = recelgnow + CidNadLg + 1;
 871   3                  
 872   3                                      pi = &MfComData;
 873   3                  status = PcdComTransceive(pi);
 874   3                  continue;
 875   3              }
 876   2      
 877   2      
 878   2              if ((MfComData.MfData[0] & 0xF0) == 0xA0)
 879   2              //发送后续数据
 880   2              {
 881   3                  MfComData.MfCommand = PCD_TRANSCEIVE;
 882   3                  for(i=0; i<CidNadLg; i++)
 883   3                  {   MfComData.MfData[i+1] = 0;  }               
 884   3                  PCB_I ^= 1;
 885   3                  if(sendlgsum > FSD-1-CidNadLg)
 886   3                  {  
 887   4                      sendlgnow  = FSD-1-CidNadLg; 
 888   4                      sendlgsum -= sendlgnow; 
 889   4                      PCB_I |= 0x10^ g_bIblock;
 890   4                      g_bIblock = !g_bIblock;
 891   4                  }    
 892   3                  else
 893   3                  {
 894   4                      sendlgnow = sendlgsum;
 895   4                      PCB_I &= 0xEF;
 896   4                      PCB_I |= g_bIblock;
 897   4                      g_bIblock = !g_bIblock;
 898   4                  }
 899   3                  MfComData.MfLength  = sendlgnow + CidNadLg + 1;
 900   3                  MfComData.MfData[0] = 0x02 | (CID_NAD<<3) | PCB_I;
 901   3          
 902   3                  memcpy(&MfComData.MfData[CidNadLg+1], pCommand+sendlgok, sendlgnow); 
 903   3                  sendlgok += sendlgnow;
 904   3                  pi = &MfComData;
 905   3                  status = PcdComTransceive(pi);
 906   3                  continue;
 907   3              }
 908   2              if ((MfComData.MfData[0] & 0xF0) == 0x10)
 909   2              //接收后续数据
 910   2              {
 911   3                  recelgnow = MfComData.MfLength/8 - 1 - CidNadLg;
 912   3                  memcpy(pCommand+recelgsum, &MfComData.MfData[CidNadLg+1], recelgnow);  
 913   3                  recelgsum += recelgnow;
 914   3                  
 915   3                  MfComData.MfCommand = PCD_TRANSCEIVE;
 916   3                  for(i=0; i<CidNadLg; i++)
 917   3                  {  MfComData.MfData[i+1]=0;  }               
 918   3                  MfComData.MfLength = CidNadLg + 1;
 919   3                  if(MfComData.MfData[0] & 0x01) 
 920   3                  {  PCB_R &= 0xFE;  }
 921   3                  else 
 922   3                  {  PCB_R |= 0x01;  }
C51 COMPILER V9.00   ISO14443A                                                             06/07/2017 15:27:12 PAGE 16  

 923   3                  MfComData.MfData[0] = PCB_R | (CID_NAD<<3) & 0xFB;
 924   3                  pi = &MfComData;
 925   3                  
 926   3                  status = PcdComTransceive(pi);
 927   3                  continue;    
 928   3              }
 929   2              status = MI_COM_ERR;
 930   2              break;
 931   2          }     
 932   1          return status;
 933   1      }
