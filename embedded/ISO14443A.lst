 566          //input:addr=绝对块号
 567          /////////////////////////////////////////////////////////////////////
 568          char PcdTransfer(unsigned char addr)
 569          {
 570   1          char idata status;
 571   1          struct TranSciveBuffer MfComData;
 572   1          struct TranSciveBuffer *pi;
 573   1          pi = &MfComData;
 574   1      
 575   1          PcdSetTmo(5);
 576   1          MfComData.MfCommand = PCD_TRANSCEIVE;
 577   1          MfComData.MfLength  = 2;
 578   1          MfComData.MfData[0] = PICC_TRANSFER;
 579   1          MfComData.MfData[1] = addr;
 580   1      
 581   1          status = PcdComTransceive(pi);
 582   1          if (status != MI_NOTAGERR)
 583   1          {
 584   2              if (MfComData.MfLength != 4)
 585   2              {  status = MI_BITCOUNTERR;    }
 586   2              else
 587   2              {
 588   3                 MfComData.MfData[0] &= 0x0F;
 589   3                 switch (MfComData.MfData[0])
 590   3                 {
 591   4                    case 0x00:
 592   4                       status = MI_NOTAUTHERR;
 593   4                       break;
 594   4                    case 0x0A:
 595   4                       status = MI_OK;
 596   4                       break;
 597   4                    case 0x01:
 598   4                       status = MI_VALERR;
 599   4                       break;
 600   4                    default:
 601   4                       status = MI_CODEERR;
 602   4                       break;
 603   4                 }
 604   3              }
 605   2           }
 606   1           return status;
 607   1      }
