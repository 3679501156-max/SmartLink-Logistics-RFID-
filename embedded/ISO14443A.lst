 185          /////////////////////////////////////////////////////////////////////
 186          //将Mifare_One卡密钥转换为RC500接收格式
 187          //input: uncoded=6字节未转换的密钥
 188          //output:coded=12字节转换后的密钥
 189          /////////////////////////////////////////////////////////////////////
 190          char ChangeCodeKey(unsigned char *pUncoded,unsigned char *pCoded)
 191          {
 192   1         unsigned char idata  cnt=0;
 193   1         unsigned char idata  ln=0;
 194   1         unsigned char idata  hn=0;
 195   1      
 196   1         for (cnt=0; cnt<6; cnt++)
 197   1         {
 198   2            ln = pUncoded[cnt] & 0x0F;
 199   2            hn = pUncoded[cnt] >> 4;
 200   2            pCoded[cnt*2+1] = (~ln<<4) | ln;
 201   2            pCoded[cnt*2]   = (~hn<<4) | hn;
 202   2         }
 203   1         return MI_OK;
 204   1      }
