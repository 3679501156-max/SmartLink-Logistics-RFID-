 542          //////////////////////////////////////////////////////////////////////
 543          char WriteSR4K(unsigned char addr,unsigned char *writedata)
 544          {
 545   1          char status;
 546   1          struct TranSciveBuffer MfComData;
 547   1          struct TranSciveBuffer *pi;
