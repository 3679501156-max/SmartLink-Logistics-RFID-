 551   1          MfComData.MfLength  = 6;
 552   1          MfComData.MfData[0] = 9;
 553   1          MfComData.MfData[1] = addr;
 554   1          MfComData.MfData[2] = *writedata;
 555   1          MfComData.MfData[3] = *(writedata+1);
 556   1          MfComData.MfData[4] = *(writedata+2);
 557   1          MfComData.MfData[5] = *(writedata+3);
 558   1          status = PcdComTransceive(pi);
