 241          /////////////////////////////////////////////////////////////////////
 242          char At88rf020Read(unsigned char addr, unsigned char *readdata)
 243          {
 244   1          char status;
 245   1          struct TranSciveBuffer MfComData;
 246   1          struct TranSciveBuffer *pi;
 247   1          pi = &MfComData;
 248   1          
 249   1          PcdSetTmo(g_cFWI);
 250   1          MfComData.MfCommand = PCD_TRANSCEIVE;
 251   1          MfComData.MfLength  = 10;
 252   1          MfComData.MfData[0] = AT88RF020_READ|0x10;
 253   1          MfComData.MfData[1] = addr;
 254   1          
 255   1          status = PcdComTransceive(pi);
 256   1          
 257   1          if ((status==MI_OK) && (MfComData.MfLength==0x50))
 258   1          {   memcpy(readdata, &MfComData.MfData[2], 8);    }
 259   1          else
 260   1          {   status = MI_COM_ERR;   }
 261   1          
 262   1          return status;
 263   1      }
