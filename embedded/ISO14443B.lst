 590          //////////////////////////////////////////////////////////////////////
 591          //SR176卡读UID
 592          //////////////////////////////////////////////////////////////////////
 593          char GetUIDSR4K(unsigned char *UID)
 594          {
 595   1          char status;
 596   1          unsigned char i;
 597   1          struct TranSciveBuffer MfComData;
 598   1          struct TranSciveBuffer *pi;
 599   1          pi = &MfComData;
 600   1          
 601   1          PcdSetTmo(5);
 602   1          MfComData.MfCommand = PCD_TRANSCEIVE;
 603   1          MfComData.MfLength  = 1;
 604   1          MfComData.MfData[0] = 0x0B;
 605   1       
 606   1          status = PcdComTransceive(pi);
 607   1      
 608   1          if (MfComData.MfLength!=64) status = MI_COM_ERR;
 609   1          if (status == MI_OK)
 610   1          {
 611   2              for(i=0;i<8;i++)
 612   2              {  *(UID+7-i) = MfComData.MfData[i];  }
C51 COMPILER V9.00   ISO14443B                                                             06/07/2017 15:27:12 PAGE 11  

 613   2          }
 614   1          return status;  
 615   1      }                                         
