 562          //////////////////////////////////////////////////////////////////////
 563          //SR176卡鉴别
 564          //////////////////////////////////////////////////////////////////////
 565          char AuthSR4K(unsigned char *rnd,unsigned char *sig)
 566          {
 567   1          char status;
 568   1          struct TranSciveBuffer MfComData;
 569   1          struct TranSciveBuffer *pi;
 570   1          pi = &MfComData;
 571   1          PcdSetTmo(9);
 572   1          MfComData.MfCommand = PCD_TRANSCEIVE;
 573   1          MfComData.MfLength  = 7;
 574   1          MfComData.MfData[0] = 0x0A;
 575   1          memcpy(&MfComData.MfData[1], rnd, 6);
 576   1          
 577   1          status = PcdComTransceive(pi);
 578   1          
 579   1          if (status!=MI_OK) status = MI_COLLERR; // collision occurs
 580   1          if (MfComData.MfLength!=24) status=MI_COM_ERR;
 581   1          if (status == MI_OK)
 582   1          {
 583   2              * sig    = MfComData.MfData[0];
 584   2              *(sig+1) = MfComData.MfData[1];
 585   2              *(sig+2) = MfComData.MfData[2];
 586   2          }
 587   1          return status;  
 588   1      }  
