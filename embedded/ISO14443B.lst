 365          //////////////////////////////////////////////////////////////////////
 366          char SelectSR(unsigned char *Chip_ID)
 367          {
 368   1          char  status = MI_OK;
 369   1          struct TranSciveBuffer MfComData;
 370   1          struct TranSciveBuffer *pi;
 371   1          pi = &MfComData;
 372   1      
 373   1          ClearBitMask(RegControl,0x08);         // disable crypto 1 unit   
 374   1          
 375   1          PcdSetTmo(5);
 376   1          MfComData.MfCommand = PCD_TRANSCEIVE;
 377   1          MfComData.MfLength  = 2;
 378   1          MfComData.MfData[0] = 6;                   
 379   1          MfComData.MfData[1] = 0;                
 380   1          
 381   1          status = PcdComTransceive(pi);
 382   1      
 383   1          if (status!=MI_OK && status!=MI_NOTAGERR) 
 384   1          {   status = MI_COLLERR;   }          // collision occurs
 385   1          
 386   1          if(MfComData.MfLength != 8)
 387   1          {   status = MI_COM_ERR;   }
 388   1          
 389   1          if (status == MI_OK)
 390   1          {   
 391   2               PcdSetTmo(5);
 392   2               MfComData.MfCommand = PCD_TRANSCEIVE;
 393   2               MfComData.MfLength  = 2;
 394   2               MfComData.MfData[1] = MfComData.MfData[0];                    
 395   2               MfComData.MfData[0] = 0x0E;                 
 396   2               
 397   2               status = PcdComTransceive(pi); 
 398   2               
 399   2               if (status!=MI_OK && status!=MI_NOTAGERR)  // collision occurs
 400   2               {   status = MI_COLLERR;   }               // collision occurs
 401   2               if (MfComData.MfLength != 8) 
 402   2               {   status = MI_COM_ERR;     }
 403   2               if (status == MI_OK)
 404   2               {  *Chip_ID = MfComData.MfData[0];  }
 405   2          }   
 406   1          
 407   1          return status;
 408   1      }  
