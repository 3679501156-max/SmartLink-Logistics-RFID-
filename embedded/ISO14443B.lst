  13          //////////////////////////////////////////////////////////////////////
  14          //REQUEST B
  15          //////////////////////////////////////////////////////////////////////
  16          char M531PiccRequestB(unsigned char req_code, 
  17                                unsigned char AFI, 
  18                                unsigned char N, 
  19                                unsigned char *ATQB)
  20          {
  21   1          char  status;
  22   1          struct TranSciveBuffer MfComData;
  23   1          struct TranSciveBuffer *pi;
  24   1          pi=&MfComData;
  25   1      
  26   1          ClearBitMask(RegControl,0x08);      // disable crypto 1 unit   
  27   1          
  28   1         // SetBitMask(RegTxControl,0x03);      // Tx2RF-En, Tx1RF-En enable
  29   1      
  30   1          PcdSetTmo(5);
  31   1          MfComData.MfCommand = PCD_TRANSCEIVE;
  32   1          MfComData.MfLength  = 3;
  33   1          MfComData.MfData[0] = ISO14443B_ANTICOLLISION;             // APf code
  34   1          MfComData.MfData[1] = AFI;                // 
  35   1          MfComData.MfData[2] = ((req_code<<3)&0x08) | (N&0x07);  // PARAM
  36   1       
  37   1          status = PcdComTransceive(pi);
  38   1      
  39   1          if (status!=MI_OK && status!=MI_NOTAGERR)
  40   1          {   status = MI_COLLERR;   }
  41   1          
  42   1          if (MfComData.MfLength != 96)
  43   1          {   status = MI_COM_ERR;   }
  44   1          
  45   1          if (status == MI_OK) 
  46   1          {   
  47   2              memcpy(ATQB, &MfComData.MfData[0], 16);
  48   2              PcdSetTmo(ATQB[11]>>4); // set FWT 
  49   2          }   
  50   1          return status;
  51   1      }                      
