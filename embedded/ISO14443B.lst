 513          //////////////////////////////////////////////////////////////////////
 514          //SRIX4K卡读块
 515          //////////////////////////////////////////////////////////////////////
 516          char ReadSR4K(unsigned char addr,unsigned char *readdata)
 517          {
 518   1          char status;
 519   1          struct TranSciveBuffer MfComData;
 520   1          struct TranSciveBuffer *pi;
 521   1          pi = &MfComData;
 522   1          PcdSetTmo(5);
 523   1          MfComData.MfCommand = PCD_TRANSCEIVE;
 524   1          MfComData.MfLength  = 2;
 525   1          MfComData.MfData[0] = 8;
 526   1          MfComData.MfData[1] = addr;
 527   1          status = PcdComTransceive(pi);
 528   1          if (status!=MI_OK) status = MI_COLLERR; // collision occurs
 529   1          if (MfComData.MfLength!=32) status = MI_COM_ERR;
 530   1          if (status == MI_OK)
 531   1          {
 532   2              *readdata     = MfComData.MfData[0];
 533   2              *(readdata+1) = MfComData.MfData[1];
 534   2              *(readdata+2) = MfComData.MfData[2];
 535   2              *(readdata+3) = MfComData.MfData[3];
 536   2          }
 537   1          return status;  
 538   1      }
