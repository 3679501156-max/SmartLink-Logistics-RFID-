 108   1          {
 109   2               pi = &MfComData;
 110   2               ClearBitMask(RegChannelRedundancy, 0x04);
 111   2               SetBitMask(RegCoderControl, 0x80);
 112   2               SetBitMask(RegTxControl, 0x10);
 113   2               MfComData.MfCommand = PCD_TRANSCEIVE;
