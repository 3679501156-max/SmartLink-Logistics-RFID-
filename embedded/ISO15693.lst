  21          char ISO15693_Inventory (unsigned char flags,
  22                                   unsigned char AFI, 
  23                                   unsigned char masklengh, 
  24                                   unsigned char *uid, 
  25                                   unsigned char *resp)
  26          {
  27   1          unsigned char SndCNT, cnt, status;
  28   1          struct TranSciveBuffer MfComData;
  29   1          struct TranSciveBuffer *pi;
  30   1          pi = &MfComData;
  31   1              
  32   1          ClearBitMask(RegCoderControl, 0x80);
  33   1                  
  34   1          MfComData.MfCommand = PCD_TRANSCEIVE;       
  35   1          MfComData.MfData[0] = flags;
  36   1          MfComData.MfData[1] = ISO15693_INVENTORY;
  37   1          SndCNT = 2;
  38   1          if (flags & 0x10)
  39   1          {
  40   2              MfComData.MfData[SndCNT] = AFI;         
  41   2              SndCNT++;
  42   2          }
  43   1          MfComData.MfData[SndCNT] = masklengh;
  44   1          SndCNT++;
  45   1          if (masklengh%8)
  46   1          {    cnt = masklengh/8 + 1;    }
  47   1          else
  48   1          {    cnt = masklengh/8;        }
  49   1          if (cnt)
  50   1          {    memcpy(&MfComData.MfData[SndCNT], uid, cnt);    }
  51   1          MfComData.MfLength  = cnt + SndCNT;
  52   1      
  53   1          status = ISO15693_Transceive(pi);
  54   1         
C51 COMPILER V9.00   ISO15693                                                              06/07/2017 15:27:12 PAGE 2   

  55   1          if (status == MI_OK)
  56   1          {
  57   2              if (MfComData.MfLength != 0x50)
  58   2              {    status = MI_BITCOUNTERR;    }
  59   2              else
  60   2              {    memcpy(resp, &MfComData.MfData[1], 9);    }
  61   2          }     
  62   1          return status;
  63   1      }
