 561          /////////////////////////////////////////////////////////////////////
 562          char ISO15693_Lock_DSFID (unsigned char flags, unsigned char *uid)
 563          {
 564   1          unsigned char cnt, status;
 565   1          struct TranSciveBuffer MfComData;
 566   1          struct TranSciveBuffer *pi;
 567   1          pi = &MfComData;
 568   1            
 569   1          ClearBitMask(RegCoderControl, 0x80);
 570   1        
 571   1          if (flags & 0x40)
 572   1          {    MfComData.MfCommand = PCD_TRANSMIT;   }
 573   1          else
 574   1          {    MfComData.MfCommand = PCD_TRANSCEIVE;   }
 575   1          MfComData.MfData[0] = flags;
 576   1          MfComData.MfData[1] = ISO15693_LOCK_DSFID;
 577   1          cnt = 2;
 578   1          if (flags & 0x20) // flags & 0x20 - Adresflag request flags & 
 579   1                        // 0x10 - Selectflag request
 580   1          {
 581   2              memcpy (&MfComData.MfData[2], uid, 8);
 582   2              cnt = cnt + 8;
 583   2          }
 584   1          MfComData.MfLength = cnt;
 585   1      
 586   1          status = ISO15693_Transceive( pi );
 587   1              
 588   1          if (status != MI_OK)
 589   1          {    return status;   }
 590   1          else if (!(flags & 0x40)) 
 591   1          {
 592   2               if (MfComData.MfLength != 0x08)
 593   2               {    status = MI_BITCOUNTERR;    }
 594   2               return status;
 595   2          }
 596   1          else
 597   1          {
 598   2               DelayMs(10);
 599   2               pi = &MfComData;
 600   2          
 601   2               SetBitMask(RegCoderControl, 0x80);
 602   2              
 603   2               MfComData.MfCommand = PCD_TRANSCEIVE;
 604   2               MfComData.MfLength = 0;
 605   2      
 606   2               status = ISO15693_Transceive( pi );
 607   2      
 608   2               if ( (status == MI_OK) && (MfComData.MfLength != 0x08) )
 609   2               {    status = MI_BITCOUNTERR;    }
 610   2               return status;
 611   2           }
 612   1      }
