 433          
 434          void InitializeSystem()
 435          {
 436   1          TMOD &= 0x0F;
 437   1          TMOD |= 0x21;
 438   1          PCON |= 0x80;
 439   1          SCON  = 0x50;
 440   1          TH1 = TL1 = BOUND9600; 
 441   1          TR1=1;
 442   1              P3M1 = 0x00;            //初始化P3.3口为准双向口
 443   1          P3M0 = 0x08;
 444   1          P0 = P1 = P2 = P3 = 0xFF;
 445   1         
 446   1          IE |= 0x90;
 447   1      }
 448          
