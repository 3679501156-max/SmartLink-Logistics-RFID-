 450          /////////////////////////////////////////////////////////////////////
 451          //初始化RC632
 452          /////////////////////////////////////////////////////////////////////
 453          void Rc632Ready()
 454          {
 455   1          char status;
 456   1          delay(100);
 457   1          status = PcdReset();
 458   1          if(status != MI_OK)
 459   1          {
 460   2              delay(10);
 461   2              status = PcdReset();
 462   2          } 
 463   1          if(status != MI_OK)
 464   1          {
 465   2              delay(10);
 466   2              status = PcdReset();
 467   2          } 
 468   1          if(status == MI_OK)
 469   1          {
 470   2              g_bRc632Ok = 1;
 471   2          }       
 472   1      }
