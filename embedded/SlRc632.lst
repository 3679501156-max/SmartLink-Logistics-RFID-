 813          
 814              MfComData.MfCommand = PCD_WRITEE2;
 815              MfComData.MfLength  = length+2;
 816              MfComData.MfData[0] = startaddr&0xFF;
 817              MfComData.MfData[1] = (startaddr >> 8) & 0xFF;
 818              memcpy(&MfComData.MfData[2], writedata, length);    
 819          
 820              status = PcdComTransceive(pi);
 821              return status;
 822          }
 823          */
