 724   1         for (i=0; i<pi->MfLength; i++)
 725   1         {
 726   2             WriteRawRC(RegFIFOData,pi->MfData[i]);
 727   2         }
 728   1      
 729   1         WriteRawRC(RegCommand, PCD_TRANSCEIVE);        // start to send command to label
 730   1      
 731   1         i = 0x3000;
 732   1         do
 733   1         {
C51 COMPILER V9.00   SLRC632                                                               06/07/2017 15:27:11 PAGE 13  

 734   2             n = ReadRawRC(RegInterruptRq);
