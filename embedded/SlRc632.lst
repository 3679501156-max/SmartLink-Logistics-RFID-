 794              status = PcdComTransceive(pi);
 795          
C51 COMPILER V9.00   SLRC632                                                               06/07/2017 15:27:11 PAGE 14  

 796              if (status == MI_OK)
 797              {   memcpy(readdata, &MfComData.MfData[0], length);    }
 798              return status;
 799          }
