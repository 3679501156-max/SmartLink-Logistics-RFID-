 382          /////////////////////////////////////////////////////////////////////
 383          //置RC632寄存器位
 384          //input:reg=寄存器地址
 385          //      mask=置位值
 386          /////////////////////////////////////////////////////////////////////
 387          void SetBitMask(unsigned char reg,unsigned char mask)  
 388          {
 389   1          char idata tmp = 0x00;
 390   1         tmp = ReadRawRC(reg);
 391   1         WriteRawRC(reg,tmp | mask);  // set bit mask
 392   1      }
 393          
 394          /////////////////////////////////////////////////////////////////////
 395          //清RC632寄存器位
 396          //input:reg=寄存器地址
 397          //      mask=清位值
 398          /////////////////////////////////////////////////////////////////////
 399          void ClearBitMask(unsigned char reg,unsigned char mask)  
 400          {
 401   1          char idata tmp = 0x00;
 402   1         tmp = ReadRawRC(reg);
 403   1         WriteRawRC(reg, tmp & ~mask);  // clear bit mask
 404   1      } 
