 787          
 788              MfComData.MfCommand = PCD_READE2;
 789              MfComData.MfLength  = 3;
 790              MfComData.MfData[0] = startaddr&0xFF;
 791              MfComData.MfData[1] = (startaddr >> 8) & 0xFF;
 792              MfComData.MfData[2] = length;
