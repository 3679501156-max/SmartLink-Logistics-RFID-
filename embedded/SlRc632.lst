 647          /////////////////////////////////////////////////////////////////////
 648          //  通过RC632和ISO14443卡通讯
 649          //input: pi->MfCommand = RC632命令字
 650          //       pi->MfLength  = 发送的数据长度
 651          //       pi->MfData[]  = 发送数据
 652          //output:status        = 错误字
 653          //       pi->MfLength  = 接收的数据BIT长度
 654          //       pi->MfData[]  = 接收数据
 655          /////////////////////////////////////////////////////////////////////
 656          char ISO15693_Transceive(struct TranSciveBuffer *pi)
 657          {
 658   1         bit recebyte = 0;
 659   1         char status  = MI_COM_ERR;
 660   1         unsigned char n,waitFor,TimerReload;
 661   1         unsigned int i;
 662   1         switch (pi->MfCommand)
 663   1         {
 664   2            case PCD_TRANSMIT:
 665   2               waitFor = 0x10;
 666   2               break;
 667   2            default:
 668   2               waitFor = 0x28;
 669   2               recebyte=1;
 670   2               break;
 671   2         }
 672   1         switch (pi->MfData[1])
 673   1         {
 674   2              case ISO15693_STAY_QUIET:
C51 COMPILER V9.00   SLRC632                                                               06/07/2017 15:27:11 PAGE 12  

 675   2                 TimerReload = 0x04;    // 2048/fc => 0x01 = 151 us 
 676   2                 break;
 677   2              case ISO15693_SELECT:
 678   2              case ISO15693_RESET_TO_READY:
 679   2                         TimerReload = 0x0F;    // 2048/fc => 0x01 = 151 us 
 680   2                 break;
 681   2              case ISO15693_LOCK_AFI:
 682   2              case ISO15693_LOCK_DSFID:
 683   2              case ISO15693_LOCK_BLOCK:
 684   2              case ISO15693_WRITE_SINGLE_BLOCK:
 685   2              case ISO15693_WRITE_MULTIPLE_BLOCKS:
 686   2              case ISO15693_WRITE_AFI:
 687   2              case ISO15693_WRITE_DSFID:
 688   2                 TimerReload = 0x29;    // 2048/fc => 0x01 = 151 us 
 689   2                 break;
 690   2              case ISO15693_READ_SINGLE_BLOCK:
 691   2                 TimerReload = 0x17;    // 2048/fc => 0x01 = 151 us 
 692   2                 break;
 693   2              case ISO15693_INVENTORY:
 694   2                 TimerReload = 0x1F;    // 2048/fc => 0x01 = 151 us 
 695   2                 break;
 696   2              case ISO15693_GET_SYSTEM_INFO:
 697   2                 TimerReload = 0x25;    // 2048/fc => 0x01 = 151 us 
 698   2                 break;
 699   2              case ISO15693_GET_MULTIPLE_BLOCK_SECURITY:
 700   2                 TimerReload = 0x40;//(0x04+(cmd[cmdlen-1]+0x01))*0x02 + 0x04 + 0x01;    // 2048/fc => 0x01 = 15
             -1 us 
 701   2                 break;                                                                                                                 // (0x04 + cmd[cmdlen - 1])*0x02 -> Time for all receivedBytes, 0x04 -> T
             -ime bevore and after response, 0x01 additional
 702   2              case ISO15693_READ_MULTIPLE_BLOCKS:
 703   2                 TimerReload = 0x40;//(0x04+0x04*(cmd[cmdlen-1]+0x01))*0x02 + 0x04 + 0x01;    // 2048/fc => 0x01
             - = 151 us 
 704   2                 break;
 705   2              default:
 706   2                 TimerReload = 0x86; // 2048/fc => 0x01 = 151 us 
 707   2                 break;
 708   2         }
 709   1         
 710   1         WriteRawRC(RegPage,0x00);
 711   1         WriteRawRC(RegFIFOLevel,0x1A);        
 712   1             
 713   1         SetBitMask(RegChannelRedundancy, 0x04);
 714   1         WriteRawRC(RegTimerReload, TimerReload);
 715   1         WriteRawRC(RegTimerControl, 0x06);
 716   1      
 717   1         SetBitMask(RegControl,0x01);
 718   1           
 719   1         WriteRawRC(RegCommand, 0x00);
